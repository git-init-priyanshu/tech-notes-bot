{
  "name": "tech-notes-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute tech-notes --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute tech-notes --local --file=schema.sql",
    "db:migrate": "wrangler d1 execute tech-notes --remote --file=migrations/0001_schedule_and_catalog.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.42.0"
  }
}
